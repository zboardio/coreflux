# Copy to .env next to docker-compose.yml. Never commit .env.
# TIMESCALE_PASSWORD on the broker is UNS_WRITER_PASSWORD below: enter it as a SECRET in the broker
# (Hub > System Config > ENV & Secrets), never in a notebook.

# Encrypts the broker's secret store. Generate once, store it in your password manager.
# Generate with: python3 -c "import base64,secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"
COREFLUX_SECRET_KEY=

# The historian's database.
TIMESCALE_DB=plc

# The database superuser (postgres): for applying SQL by hand, never for the broker or Grafana.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=

# uns_writer, the broker's store route: INSERT only.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
UNS_WRITER_PASSWORD=

# grafana_reader, Grafana's datasource: SELECT only.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
GRAFANA_READER_PASSWORD=

# Grafana's admin user.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
GRAFANA_ADMIN_PASSWORD=

# Ports on 127.0.0.1 (defaults in docker-compose.yml).
MQTT_PORT=1883
HUB_PORT=3000
GRAFANA_PORT=3001
TIMESCALE_PORT=5432
