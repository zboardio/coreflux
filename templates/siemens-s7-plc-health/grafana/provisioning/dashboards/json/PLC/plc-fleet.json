          "rawQuery": true,
          "rawSql": "SELECT plc_id AS \"PLC\", area, model, firmware, state, path_states AS \"paths\", health AS \"health loop\", cyc_avg_ms AS \"cycle avg\", cyc_max_5m_ms AS \"cycle max 5 min\", cyc_max_pct AS \"of watchdog\", faults_24h AS \"error-OB calls 24 h\", data_age_s AS \"last good read\", last_boot AS \"last boot\", severity, CASE family WHEN 's7-300' THEN 'plc-detail-s7-300' WHEN 's7-1500' THEN 'plc-detail-s7-1500' WHEN 's7-1200' THEN 'plc-detail-s7-1200' ELSE 'plc-fleet' END AS \"detail\" FROM plc_latest WHERE area IN ($area) AND family IN ($family) AND model IN ($model) ORDER BY severity DESC, faults_24h DESC, plc_id",
