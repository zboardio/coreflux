          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH p AS (SELECT r.plc_id FROM plc_registry r LEFT JOIN plc_model m ON m.model = r.model WHERE coalesce(r.area, '(none)') IN ($area) AND coalesce(r.family, m.family, '(unknown)') IN ($family) AND coalesce(r.model, '(unknown)') IN ($model)) SELECT e.*, CASE plc_family(e.\"PLC\") WHEN 's7-300' THEN 'plc-detail-s7-300' WHEN 's7-1500' THEN 'plc-detail-s7-1500' WHEN 's7-1200' THEN 'plc-detail-s7-1200' ELSE 'plc-fleet' END AS \"detail\" FROM ( (SELECT s.ts AS \"time\", s.plc_id AS \"PLC\", 'verdict' AS \"source\", s.via AS \"path\", s.signal || ' ' || coalesce(s.prev, '—') || ' → ' || s.value AS \"event\" FROM plc_state_change s JOIN p USING (plc_id) WHERE $__timeFilter(s.ts)) UNION ALL (SELECT f.ts_fault, f.plc_id, 'fault before STOP', NULL, 'OB' || f.fault_ob || ', event class 0x' || upper(to_hex(f.ev_class::integer)) || ', fault id 0x' || upper(to_hex(f.flt_id::integer)) FROM plc_fault f JOIN p USING (plc_id) WHERE $__timeFilter(f.ts_fault)) UNION ALL (SELECT o.ts_plc, p.plc_id, 'error OB, newest call', o.via, o.ob || ' ' || o.fault_code || coalesce(' ' || o.fault_text, '') || ', ' || o.calls || ' calls since boot' FROM p CROSS JOIN unnest('{80,82,83,86,121,122}'::smallint[]) AS k(ob), LATERAL (SELECT * FROM plc_ob_call_text t WHERE t.plc_id = p.plc_id AND t.ob_nr = k.ob AND $__timeFilter(t.ts_plc) ORDER BY t.ts_plc DESC LIMIT 1) o) ORDER BY 1 DESC LIMIT 200) e ORDER BY 1 DESC",
          "refId": "A"
        }
      ],
      "title": "Feed — newest first",
