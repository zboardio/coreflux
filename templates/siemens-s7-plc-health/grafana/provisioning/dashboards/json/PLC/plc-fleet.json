          "rawQuery": true,
          "rawSql": "SELECT count(*) AS \"PLCs\", count(*) FILTER (WHERE state = 3) AS \"RUN\", count(*) FILTER (WHERE state IN (0, 1, 2)) AS \"STOP / STARTUP\", count(*) FILTER (WHERE state = -1) AS \"UNREACHABLE\", count(*) FILTER (WHERE state IS NULL OR state = -2) AS \"NO DATA\", count(*) FILTER (WHERE state IS NOT NULL AND state <> -1 AND paths_online < paths_total) AS \"path down\", count(*) FILTER (WHERE health IN (1, 2)) AS \"health loop\", count(*) FILTER (WHERE cyc_max_pct >= 80) AS \"cycle ≥ 80 %\" FROM plc_latest WHERE area IN ($area) AND family IN ($family) AND model IN ($model)",
