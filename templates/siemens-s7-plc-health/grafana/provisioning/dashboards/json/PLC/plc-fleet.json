    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescale-edge"
      },
      "description": "One lane per PLC: its state at the range's start and after every change of the broker's DeviceStatus or CpuScanning verdict on its paths (plc_state_change, kept forever; plc_verdict_state()). RUN, STOP (an online path, Seq frozen), UNREACHABLE (no path online), UNKNOWN, NO VERDICT (none stored yet). Verdicts only: an outage of the broker itself does not appear here (the table above says NO DATA). Cheap at any range: a few rows a day per PLC.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          },
          "mappings": [
            {
              "options": {
                "-1": {
                  "color": "orange",
                  "index": 2,
                  "text": "UNREACHABLE"
                },
                "-2": {
                  "color": "text",
                  "index": 3,
                  "text": "UNKNOWN"
                },
                "0": {
                  "color": "red",
                  "index": 1,
                  "text": "STOP"
                },
                "3": {
                  "color": "green",
                  "index": 0,
                  "text": "RUN"
                }
              },
              "type": "value"
            },
            {
              "options": {
                "match": "null",
                "result": {
                  "color": "text",
                  "index": 0,
                  "text": "NO VERDICT"
                }
              },
              "type": "special"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 28
      },
      "id": 210,
      "options": {
        "alignValue": "left",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "mergeValues": true,
        "rowHeight": 0.8,
        "showValue": "never",
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescale-edge"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH p AS (SELECT r.plc_id FROM plc_registry r LEFT JOIN plc_model m ON m.model = r.model WHERE coalesce(r.area, '(none)') IN ($area) AND coalesce(r.family, m.family, '(unknown)') IN ($family) AND coalesce(r.model, '(unknown)') IN ($model)), t AS (SELECT p.plc_id, $__timeFrom()::timestamptz AS time FROM p UNION SELECT s.plc_id, s.ts FROM plc_state_change s JOIN p USING (plc_id) WHERE $__timeFilter(s.ts) AND s.signal IN ('DeviceStatus', 'CpuScanning') UNION SELECT p.plc_id, least(now(), $__timeTo()::timestamptz) FROM p) SELECT time, plc_id AS metric, CASE plc_verdict_state(plc_id, time) WHEN 'run' THEN 3 WHEN 'frozen' THEN 0 WHEN 'unreachable' THEN -1 WHEN 'unknown' THEN -2 END AS value FROM t ORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "CPU state per PLC — the broker's verdicts",
      "type": "state-timeline"
    },
