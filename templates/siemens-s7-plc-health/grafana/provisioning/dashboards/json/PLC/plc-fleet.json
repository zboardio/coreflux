          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT coalesce(r.family, m.family, '(unknown)') AS family, coalesce(r.model, '(unknown)') AS model, coalesce(plc_firmware_of(r.plc_id), '(unknown)') AS firmware, count(*) AS \"PLCs\", string_agg(DISTINCT coalesce(r.area, '(none)'), ', ') AS \"areas\" FROM plc_registry r LEFT JOIN plc_model m ON m.model = r.model WHERE r.plc_id IN (SELECT r.plc_id FROM plc_registry r LEFT JOIN plc_model m ON m.model = r.model WHERE coalesce(r.area, '(none)') IN ($area) AND coalesce(r.family, m.family, '(unknown)') IN ($family) AND coalesce(r.model, '(unknown)') IN ($model)) GROUP BY 1, 2, 3 ORDER BY 1, 2, 3",
          "refId": "A"
        }
      ],
      "title": "By family, model and firmware",
      "transformations": [],
      "type": "table"
    },
