          "rawQuery": true,
          "rawSql": "WITH c AS ( SELECT plc_id, max(cyc_max_ms) AS mx, sum(cyc_avg_ms * cycles) / nullif(sum(cycles), 0) AS av, sum(cycles) AS n FROM plc_cycle_5m WHERE plc_id IN (SELECT r.plc_id FROM plc_registry r LEFT JOIN plc_model m ON m.model = r.model WHERE coalesce(r.area, '(none)') IN ($area) AND coalesce(r.family, m.family, '(unknown)') IN ($family) AND coalesce(r.model, '(unknown)') IN ($model)) AND $__timeFilter(bucket) AND $__timeFrom() > now() - interval '729 days' GROUP BY 1 UNION ALL SELECT plc_id, max(cyc_max_ms), sum(cyc_avg_ms * cycles) / nullif(sum(cycles), 0), sum(cycles) FROM plc_cycle_1h WHERE plc_id IN (SELECT r.plc_id FROM plc_registry r LEFT JOIN plc_model m ON m.model = r.model WHERE coalesce(r.area, '(none)') IN ($area) AND coalesce(r.family, m.family, '(unknown)') IN ($family) AND coalesce(r.model, '(unknown)') IN ($model)) AND $__timeFilter(bucket) AND NOT $__timeFrom() > now() - interval '729 days' GROUP BY 1) SELECT c.plc_id AS \"PLC\", coalesce(r.model, '(unknown)') AS model, c.av AS \"avg\", c.mx AS \"max\", plc_watchdog_ms(c.plc_id) AS \"watchdog\", round((c.mx / plc_watchdog_ms(c.plc_id) * 100)::numeric, 1) AS \"max of watchdog\", c.n AS \"cycles\", CASE plc_family(c.plc_id) WHEN 's7-300' THEN 'plc-detail-s7-300' WHEN 's7-1500' THEN 'plc-detail-s7-1500' WHEN 's7-1200' THEN 'plc-detail-s7-1200' ELSE 'plc-fleet' END AS \"detail\" FROM c JOIN plc_registry r USING (plc_id) ORDER BY 6 DESC NULLS LAST, 1",
          "refId": "A"
        }
      ],
      "title": "Cycle time against the watchdog, over the range",
