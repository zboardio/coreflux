# Copy to .env next to docker-compose.yml. Never commit .env.

# The coordinator by its stable path. List yours with: ls -l /dev/serial/by-id/
# ZBDongle-P (CC2652P):       /dev/serial/by-id/usb-ITead_Sonoff_Zigbee_3.0_USB_Dongle_Plus_<serial>-if00-port0
# ZBDongle-E (EFR32MG21):     /dev/serial/by-id/usb-ITEAD_SONOFF_Zigbee_3.0_USB_Dongle_Plus_V2_<serial>-if00
# Dongle Plus MG24 / Max:     /dev/serial/by-id/usb-SONOFF_SONOFF_Dongle_Plus_MG24_<serial>-if00-port0
ZIGBEE_DONGLE=

# Encrypts the broker's secret store. Generate once, store it in your password manager.
# Generate with: python3 -c "import base64,secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"
COREFLUX_SECRET_KEY=

TZ=UTC
