  "kind": 2,
  "language": "lot",
  "value": "DEFINE MODEL UnsBoolean COLLAPSED\n    ADD BOOL \"value\"\n    ADD STRING \"timestamp\"\n    ADD STRING \"datatype\"\n    ADD STRING \"status\""
 },
 {
  "kind": 2,
  "language": "lot",
